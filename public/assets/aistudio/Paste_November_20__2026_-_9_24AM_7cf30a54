function drawMinimap() {
miniCtx.clearRect(0, 0, miniCanvas.width, miniCanvas.height);
let scaleX = miniCanvas.width / 3400, scaleY = miniCanvas.height / 1850;
miniCtx.strokeStyle = "#94a3b8"; miniCtx.lineWidth = 6;
miniCtx.beginPath();
currentTrack.points.forEach((p, i) => i === 0 ? miniCtx.moveTo(p.x * scaleX, p.y * scaleY) : miniCtx.lineTo(p.x * scaleX, p.y * scaleY));
miniCtx.closePath(); miniCtx.stroke();
runners.forEach(r => {
let pos = currentTrack.getPositionAt(r.distance, 0);
miniCtx.fillStyle = r.color;
miniCtx.beginPath(); miniCtx.arc(pos.x * scaleX, pos.y * scaleY, r.isPlayer ? 5 : 3.5, 0, Math.PI * 2); miniCtx.fill();
});
}
function updateHUD() {
document.getElementById('stamina-num').innerText = Math.round(player.stamina);
const fill = document.getElementById('stamina-fill');
const iframeBadge = document.getElementById('iframe-badge');
fill.style.width = player.stamina + '%';
if (player.staminaIframeTimer > 0) {
fill.classList.add('iframe-active');
iframeBadge.style.display = 'inline';
iframeBadge.innerText = 🛡️ I-FRAMES (${player.staminaIframeTimer.toFixed(1)}s);
} else {
fill.classList.remove('iframe-active');
iframeBadge.style.display = 'none';
fill.style.background = player.exhausted ? '#ef4444' : 'linear-gradient(90deg, #10b981, #34d399)';
}
let effVel = Math.round(player.getEffectiveVelocity());
let bonusPct = Math.round(player.getTotalSpeedBonus() * 100);
document.getElementById('speed-num').innerText = effVel;
document.getElementById('buff-speed-text').innerText = bonusPct > 0 ? +${bonusPct}% BUFF : '';
const speedFill = document.getElementById('speed-fill');
speedFill.style.width = Math.min(100, effVel) + '%';
if (player.staminaIframeTimer > 0 && effVel > STAMINA_THRESHOLD) speedFill.style.background = '#22d3ee';
else if (effVel > STAMINA_THRESHOLD) speedFill.style.background = '#f43f5e';
else speedFill.style.background = '#34d399';
let currentLap = Math.min(TOTAL_LAPS, Math.floor(player.distance / currentTrack.totalLength) + 1);
let sorted = runners.slice().sort((a, b) => b.distance - a.distance);
let rank = sorted.indexOf(player) + 1;
document.getElementById('lap-num').innerText = ${currentLap}/${TOTAL_LAPS};
document.getElementById('rank-num').innerText = rank;
document.getElementById('sprint-num').innerText = ${player.sprintsLeft} / 2;
const abEl = document.getElementById('ability-status');
if (player.silenceTimer > 0) { abEl.innerText = 🔇 SILENCE (${player.silenceTimer.toFixed(1)}s); abEl.style.color = '#fb7185'; }
else if (!player.abilityUsed) { abEl.innerText = 'Sẵn sàng [F]'; abEl.style.color = '#34d399'; }
else { abEl.innerText = 'Đã dùng'; abEl.style.color = '#64748b'; }
const ultEl = document.getElementById('ult-status');
if (player.silenceTimer > 0) { ultEl.innerText = 🔇 SILENCE (${player.silenceTimer.toFixed(1)}s); ultEl.style.color = '#fb7185'; }
else if (player.ultUsed) { ultEl.innerText = 'Đã dùng'; ultEl.style.color = '#64748b'; }
else if (raceTime < ULT_UNLOCK_TIME) { ultEl.innerText = Sau ${(ULT_UNLOCK_TIME - raceTime).toFixed(1)}s; ultEl.style.color = '#94a3b8'; }
else { ultEl.innerText = 'SẴN SÀNG [G]!'; ultEl.style.color = '#f43f5e'; }
const buffBar = document.getElementById('buff-bar');
let tagsHTML = '';
if (player.activeRegenTimer > 0) tagsHTML += <span class="active-tag" style="background:#065f46; color:#34d399;">+Hồi Sức ${player.activeRegenTimer.toFixed(1)}s</span>;
if (bonusPct > 0) tagsHTML += <span class="active-tag" style="background:#78350f; color:#fbbf24;">+${bonusPct}% Speed</span>;
if (player.redChargeTimer > 0) tagsHTML += <span class="active-tag" style="background:#7f1d1d; color:#fca5a5;">Càn Lướt (${player.redHitCount}/2)</span>;
if (player.heavyTimer > 0) tagsHTML += <span class="active-tag" style="background:#881337; color:#fda4af;">⛓️ HEAVY ${player.heavyTimer.toFixed(1)}s</span>;
buffBar.innerHTML = tagsHTML;
}
function gameLoop(now) {
if (gameState !== 'PLAYING') return;
let dt = (now - lastTime) / 1000;
lastTime = now;
raceTime += dt;
let finishDistance = currentTrack.totalLength * TOTAL_LAPS;
runners.forEach(r => {
r.update(dt);
if (r.distance >= finishDistance && gameState === 'PLAYING') {
gameState = 'FINISHED';
showResult(r);
}
});
let playerPos = currentTrack.getPositionAt(player.distance, player.laneOffset);
ctx.clearRect(0, 0, canvas.width, canvas.height);
ctx.save();
ctx.translate(-(playerPos.x - canvas.width / 2), -(playerPos.y - canvas.height / 2));
currentTrack.draw(ctx);
runners.forEach(r => r.draw(ctx));
ctx.restore();
drawMinimap();
updateHUD();
if (gameState === 'PLAYING') requestAnimationFrame(gameLoop);
}
function showResult(winner) {
const modal = document.getElementById('result-modal');
const title = document.getElementById('result-title');
const desc = document.getElementById('result-desc');
if (winner === player) {
title.innerText = '🏆 CHIẾN THẮNG CHUNG CUỘC!';
title.style.color = '#34d399';
desc.innerText = Bạn đã về đích đầu tiên sau ${raceTime.toFixed(2)} giây!;
} else {
title.innerText = 😢 ${winner.name.toUpperCase()} VỀ ĐÍCH TRƯỚC!;
title.style.color = '#f43f5e';
desc.innerText = Thời gian: ${raceTime.toFixed(2)} giây. Hãy thử lại chiến thuật khác nhé!;
}
modal.style.display = 'block';
}
initHub();
requestAnimationFrame(hubLoop);



