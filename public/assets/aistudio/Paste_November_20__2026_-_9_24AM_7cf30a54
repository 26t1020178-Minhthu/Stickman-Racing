function createStadiumPoints(cx, cy, straightHalf, radius, numPts) {
let pts = new Array();
for (let i = 0; i < numPts; i++) {
let angle = (i / numPts) * Math.PI * 2;
let x = cx + Math.sign(Math.cos(angle)) * Math.pow(Math.abs(Math.cos(angle)), 0.72) * (straightHalf + radius);
let y = cy + Math.sin(angle) * radius;
pts.push({ x, y });
}
return pts;
}
class Track {
constructor(config) {
this.config = config;
this.points = config.generatePoints();
this.cumulativeLengths = new Array(0);
this.totalLength = 0;
for (let i = 0; i < this.points.length; i++) {
let p1 = this.points[i], p2 = this.points[(i + 1) % this.points.length];
this.totalLength += Math.hypot(p2.x - p1.x, p2.y - p1.y);
this.cumulativeLengths.push(this.totalLength);
}
}
getPositionAt(distance, laneOffset) {
let d = ((distance % this.totalLength) + this.totalLength) % this.totalLength;
let idx = 0;
for (let i = 0; i < this.cumulativeLengths.length - 1; i++) {
if (d >= this.cumulativeLengths[i] && d <= this.cumulativeLengths[i + 1]) { idx = i; break; }
}
let p1 = this.points[idx], p2 = this.points[(idx + 1) % this.points.length];
let segLen = this.cumulativeLengths[idx + 1] - this.cumulativeLengths[idx];
let t = segLen > 0 ? (d - this.cumulativeLengths[idx]) / segLen : 0;
let angle = Math.atan2(p2.y - p1.y, p2.x - p1.x);
return {
x: p1.x + (p2.x - p1.x) * t + (-Math.sin(angle)) * laneOffset,
y: p1.y + (p2.y - p1.y) * t + Math.cos(angle) * laneOffset,
angle
};
}
draw(ctx) {
ctx.fillStyle = this.config.bgGrass;
ctx.fillRect(0, 0, 3600, 1900);
this.config.drawScenery(ctx);
ctx.lineJoin = "round"; ctx.lineCap = "round";
ctx.strokeStyle = "#ffffff"; ctx.lineWidth = this.config.trackWidth + 12;
this.strokePath(ctx);
ctx.strokeStyle = this.config.trackColor; ctx.lineWidth = this.config.trackWidth;
this.strokePath(ctx);
ctx.strokeStyle = "rgba(255,255,255,0.35)"; ctx.lineWidth = 3;
ctx.setLineDash(new Array(15, 15)); this.strokePath(ctx); ctx.setLineDash(new Array());
let startPos = this.getPositionAt(0, 0);
ctx.save(); ctx.translate(startPos.x, startPos.y); ctx.rotate(startPos.angle);
let w = this.config.trackWidth;
for (let row = -w / 2; row < w / 2; row += 15) {
ctx.fillStyle = (Math.floor(row / 15) % 2 === 0) ? "#ffffff" : "#0f172a";
ctx.fillRect(-8, row, 8, 15);
ctx.fillStyle = (Math.floor(row / 15) % 2 === 0) ? "#0f172a" : "#ffffff";
ctx.fillRect(0, row, 8, 15);
}
ctx.restore();
}
strokePath(ctx) {
ctx.beginPath();
this.points.forEach((p, i) => i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y));
ctx.closePath(); ctx.stroke();
}
}
