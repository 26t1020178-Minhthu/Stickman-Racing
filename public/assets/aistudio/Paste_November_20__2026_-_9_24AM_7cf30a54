class StickmanRunner {
constructor(name, color, laneIndex, isPlayer, charType) {
this.name = name;
this.color = color;
this.laneOffset = -36 + laneIndex * 24;
this.isPlayer = isPlayer;
this.charType = charType;
this.distance = 0;
this.baseVelocity = 0;
this.stamina = 100;
this.exhausted = false;
this.animPhase = 0;
this.lastStepKey = null;
this.sprintsLeft = 2;
this.sprintTimer = 0;
this.abilityUsed = false;
this.ultUsed = false;
this.speedBuffs = new Array();
this.staminaIframeTimer = 0;
this.activeRegenTimer = 0;
this.redChargeTimer = 0;
this.redHitCount = 0;
this.hitTargets = new Set();
this.stunTimer = 0;
this.heavyTimer = 0;
this.silenceTimer = 0;
}
addIframes(sec) { this.staminaIframeTimer += sec; }
addActiveRegen(sec) { this.activeRegenTimer += sec; }
addSpeedBuff(pct, duration) { this.speedBuffs.push({ pct, timer: duration }); }
getTotalSpeedBonus() { return this.speedBuffs.reduce((sum, b) => sum + b.pct, 0); }
getEffectiveVelocity() {
if (this.stunTimer > 0) return 0;
let vel = this.sprintTimer > 0 ? 120 : this.baseVelocity;
return vel * (1 + this.getTotalSpeedBonus());
}
handleStride(key) {
if (this.exhausted || this.stunTimer > 0) return;
if (this.heavyTimer > 0) {
if (this.isPlayer) showLog("⛓️ BỊ HEAVY! Không thể tăng tốc!");
return;
}
if (this.lastStepKey !== key) {
this.lastStepKey = key;
this.baseVelocity = Math.min(100, this.baseVelocity + 7.8);
if (this.isPlayer) {
document.getElementById('key-q').classList.toggle('next', key === 'KeyE');
document.getElementById('key-e').classList.toggle('next', key === 'KeyQ');
}
}
}
useSprint() {
if (this.sprintsLeft <= 0 || this.sprintTimer > 0 || this.exhausted || this.stunTimer > 0) return;
if (this.heavyTimer > 0) {
if (this.isPlayer) showLog("⛓️ BỊ HEAVY! Không thể Bức tốc!");
return;
}
this.sprintsLeft--;
this.sprintTimer = 1.6;
if (this.isPlayer) showLog("🔥 BỨC TỐC KÍCH HOẠT!");
}
useAbility() {
if (this.abilityUsed || this.exhausted || this.stunTimer > 0) return;
if (this.silenceTimer > 0) {
if (this.isPlayer) showLog("🔇 BỊ SILENCE! Không thể dùng Ability!");
return;
}
this.abilityUsed = true;
if (this.charType === 'blue') {
this.addActiveRegen(1.0);
this.addIframes(2.0);
this.addSpeedBuff(0.30, 4.0);
if (this.isPlayer) showLog("🔵 ABILITY: +1s Hồi Stamina | +2s I-frames | +30% Speed (4s)!");
} else if (this.charType === 'red') {
this.addActiveRegen(0.5);
this.addIframes(1.0);
this.addSpeedBuff(0.15, 4.0);
this.redChargeTimer = 4.0;
this.redHitCount = 0;
this.hitTargets.clear();
if (this.isPlayer) showLog("🔴 ABILITY: Càn lướt 4s! Va vào đối thủ để húc choáng & cộng dồn buff!");
}
}
useUltimate() {
if (raceTime < ULT_UNLOCK_TIME || this.ultUsed || this.exhausted || this.stunTimer > 0) return;
if (this.silenceTimer > 0) {
if (this.isPlayer) showLog("🔇 BỊ SILENCE! Không thể dùng Ultimate!");
return;
}
this.ultUsed = true;
if (this.charType === 'blue') {
this.addActiveRegen(2.0);
this.addIframes(4.0);
this.addSpeedBuff(0.50, 4.0);
if (this.isPlayer) showLog("🔵 ULTIMATE: +2s Hồi Stamina | +4s I-frames | +50% Speed (4s)!");
} else if (this.charType === 'red') {
this.addActiveRegen(1.0);
this.addIframes(2.0);
this.addSpeedBuff(0.30, 4.0);
let debuffedCount = 0;
this.hitTargets.forEach(target => {
target.heavyTimer = 3.0;
target.silenceTimer = 3.0;
debuffedCount++;
this.addActiveRegen(0.5);
this.addIframes(2.0);
this.addSpeedBuff(0.20, 2.0);
});
if (this.isPlayer) {
showLog(debuffedCount > 0
? 🔴 ULTIMATE: Debuff Heavy & Silence lên ${debuffedCount} mục tiêu! Cộng dồn siêu buff!
: "🔴 ULTIMATE: +1s Stamina, +2s I-frames, +30% Speed!");
}
}
}
update(dt) {
if (this.sprintTimer > 0) this.sprintTimer = Math.max(0, this.sprintTimer - dt);
if (this.staminaIframeTimer > 0) this.staminaIframeTimer = Math.max(0, this.staminaIframeTimer - dt);
if (this.activeRegenTimer > 0) this.activeRegenTimer = Math.max(0, this.activeRegenTimer - dt);
if (this.redChargeTimer > 0) this.redChargeTimer = Math.max(0, this.redChargeTimer - dt);
if (this.stunTimer > 0) this.stunTimer = Math.max(0, this.stunTimer - dt);
if (this.heavyTimer > 0) this.heavyTimer = Math.max(0, this.heavyTimer - dt);
if (this.silenceTimer > 0) this.silenceTimer = Math.max(0, this.silenceTimer - dt);
for (let i = this.speedBuffs.length - 1; i >= 0; i--) {
this.speedBuffs[i].timer -= dt;
if (this.speedBuffs[i].timer <= 0) this.speedBuffs.splice(i, 1);
}
if (this.charType === 'red' && this.redChargeTimer > 0) {
runners.forEach(other => {
if (other !== this && !this.hitTargets.has(other)) {
if (Math.abs(this.distance - other.distance) <= 55) {
this.hitTargets.add(other);
other.stunTimer = 1.0;
if (this.redHitCount < 2) {
this.redHitCount++;
this.addIframes(2.0);
this.addSpeedBuff(0.15, 2.0);
}
if (this.isPlayer) showLog(💥 HÚC TRÚNG ${other.name.toUpperCase()}! Choáng 1s | Cộng dồn buff (${this.redHitCount}/2)!);
}
}
});
}
if (!this.isPlayer) this.updateAI(dt);
if (this.stunTimer > 0) this.baseVelocity = 0;
else this.baseVelocity = Math.max(0, this.baseVelocity - 24 * dt);
let effectiveVel = this.getEffectiveVelocity();
if (this.activeRegenTimer > 0) {
this.stamina = Math.min(100, this.stamina + 28 * dt);
if (this.exhausted && this.stamina >= 30) this.exhausted = false;
}
if (effectiveVel > STAMINA_THRESHOLD) {
if (this.staminaIframeTimer <= 0) {
let overSpeed = effectiveVel - STAMINA_THRESHOLD;
let drainRate = (2.5 + Math.pow(overSpeed, 1.42) * 0.32);
this.stamina -= drainRate * dt;
if (this.stamina <= 0) {
this.stamina = 0; this.baseVelocity = 0; effectiveVel = 0; this.exhausted = true;
if (this.isPlayer) showLog("⚠️ KIỆT SỨC! Stamina = 0, vận tốc về 0!");
}
}
} else if (effectiveVel < STAMINA_THRESHOLD) {
let slowRatio = (STAMINA_THRESHOLD - effectiveVel) / STAMINA_THRESHOLD;
let regenRate = 2 + Math.pow(slowRatio, 1.3) * 22;
this.stamina = Math.min(100, this.stamina + regenRate * dt);
if (this.exhausted && this.stamina >= 30) this.exhausted = false;
}
this.distance += effectiveVel * SPEED_MULTIPLIER * dt;
if (effectiveVel > 5) this.animPhase += (effectiveVel * 0.22) * dt;
}
updateAI(dt) {
if (this.exhausted || this.stunTimer > 0) return;
if (this.heavyTimer <= 0) {
let targetSpeed = this.stamina > 30 ? 90 : 55;
if (this.staminaIframeTimer > 0) targetSpeed = 100;
if (this.baseVelocity < targetSpeed) this.baseVelocity = Math.min(100, this.baseVelocity + 55 * dt);
}
let totalTarget = currentTrack.totalLength * TOTAL_LAPS;
if (!this.abilityUsed && this.distance > totalTarget * 0.28) this.useAbility();
if (raceTime >= ULT_UNLOCK_TIME && !this.ultUsed && this.distance > totalTarget * 0.58) this.useUltimate();
if (this.distance > totalTarget * 0.82 && this.sprintsLeft > 0) this.useSprint();
}
draw(ctx) {
let pos = currentTrack.getPositionAt(this.distance, this.laneOffset);
ctx.save();
ctx.translate(pos.x, pos.y);
if (this.redChargeTimer > 0) {
ctx.strokeStyle = 'rgba(239, 68, 68, 0.85)'; ctx.lineWidth = 3;
ctx.beginPath(); ctx.arc(0, 0, 32, 0, Math.PI * 2); ctx.stroke();
ctx.fillStyle = 'rgba(239, 68, 68, 0.18)'; ctx.fill();
}
if (this.staminaIframeTimer > 0) {
ctx.strokeStyle = '#22d3ee'; ctx.lineWidth = 2.5;
ctx.beginPath(); ctx.arc(0, 0, 26, 0, Math.PI * 2); ctx.stroke();
ctx.fillStyle = 'rgba(34, 211, 238, 0.18)'; ctx.fill();
}
ctx.save();
ctx.rotate(pos.angle);
let drawColor = this.exhausted ? '#64748b' : this.color;
ctx.strokeStyle = drawColor; ctx.fillStyle = drawColor;
ctx.lineWidth = 3.2; ctx.lineCap = 'round';
let swing = Math.sin(this.animPhase) * 11;
ctx.beginPath();
ctx.moveTo(-4, 0); ctx.lineTo(-4 + swing, -9);
ctx.moveTo(-4, 0); ctx.lineTo(-4 - swing, 9);
ctx.moveTo(-8, 0); ctx.lineTo(6, 0);
ctx.moveTo(2, 0); ctx.lineTo(2 - swing * 0.8, -10);
ctx.moveTo(2, 0); ctx.lineTo(2 + swing * 0.8, 10);
ctx.stroke();
ctx.beginPath(); ctx.arc(11, 0, 5.5, 0, Math.PI * 2); ctx.fill();
ctx.strokeStyle = '#ffffff'; ctx.lineWidth = 1.2; ctx.stroke();
ctx.restore();
ctx.font = 'bold 12px sans-serif'; ctx.textAlign = 'center';
ctx.strokeStyle = '#0f172a'; ctx.lineWidth = 3;
let statusText = this.name;
if (this.stunTimer > 0) statusText += ' [💫 CHOÁNG]';
else if (this.heavyTimer > 0 || this.silenceTimer > 0) statusText += ' [⛓️🔇 DEBUFF]';
else if (this.exhausted) statusText += ' [💤 KIỆT SỨC]';
ctx.strokeText(statusText, 0, -24);
ctx.fillStyle = (this.stunTimer > 0 || this.heavyTimer > 0) ? '#fb7185' : '#ffffff';
ctx.fillText(statusText, 0, -24);
ctx.restore();
}
}
function startRace() {
const counts = {};
voteCandidates.forEach(m => counts[m] = 0);
if (myVotedMap && counts[myVotedMap] !== undefined) counts[myVotedMap]++;
Object.values(botVotes).forEach(m => { if (counts[m] !== undefined) counts[m]++; });
let winningMap = voteCandidates.at(0), maxV = -1;
for (const [m, c] of Object.entries(counts)) {
if (c > maxV) { maxV = c; winningMap = m; }
}
